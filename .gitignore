# --- never, under any circumstances -------------------------------------
# The push key lives in here. If it ever gets committed, it is burned.
.ssh/
id_ed25519
id_ed25519.pub
id_rsa
*.pem
*.key
.netrc
.git-credentials

# The app's signing identity. It was tracked from c2a89f9 right up to v1.41.1,
# so it is already public and cannot be un-seen; ignoring it stops the repo
# handing out a fresh copy from now on. Losing this file is not a data loss —
# it is the loss of the ability to update anybody's existing install, so the
# copy that matters is the offline one, never a commit.
apk-build/*.keystore
apk-build/*.jks
/keystore-backup/

# --- big / generated / not source ---------------------------------------
.cache/
.local/
.node_modules/
node_modules/
__pycache__/
*.pyc
tests/vendor/
apk-build/build/
apk-build/android-sdk/
apk-build/tmp/
apk-build/*.apk
build/
dist/
out/
target/
uploads/
*.log
nohup.out

dl/
.android/

# --- build output that lands in docs/ instead ----------------------------
/horde-studio-web.zip
/horde-studio-version.json
/HordeStudio-v*.apk
!/HordeStudio-latest.apk

# --- OS junk -------------------------------------------------------------
.DS_Store
Thumbs.db

.sudo_as_admin_successful

# never commit: too large / scratch
android-sdk/
research/
.npm/

# One-off repro harnesses and probe scripts live here while they are being
# written and die with the investigation. Nothing in the build, the test suite
# or the publish script reads /tmp - if a check is worth keeping, it belongs in
# tests/ as *-test.js, or in tools/. A captured prompt dump sat in here once and
# got published with it; that is the whole reason for the rule.
/tmp/

# User-authored character cards and their embedded-image exports stay local.
# All cards created for this user belong in /character-cards/ and are never published.
/character-cards/
/Draconica-Malfoy-*.json
/draconica-malfoy-*.json
*.card.json
*.card.png
